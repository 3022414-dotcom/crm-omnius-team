# Database
DATABASE_URL=postgresql://omnius:omnius_secret@localhost:5432/omnius_crm
POSTGRES_USER=omnius
POSTGRES_PASSWORD=omnius_secret
POSTGRES_DB=omnius_crm
POSTGRES_PORT=5432

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Server
PORT=3000
# Dev: http://localhost:5173 | Production (Docker): http://localhost
FRONTEND_URL=http://localhost:5173
